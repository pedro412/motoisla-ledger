generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OwnerType {
  INVESTOR
  MOTOISLA
}

enum UserRole {
  ADMIN
  OPERADOR
  INVERSIONISTA
}

enum CapitalMovementType {
  CAPITAL_INICIAL
  AJUSTE_CAPITAL_INICIAL
  APORTE_CAPITAL
  RETIRO_CAPITAL
  COMPRA
  REVERSA_COMPRA
  VENTA_COSTO
  UTILIDAD_A_CAPITAL
}

enum PurchaseStatus {
  ACTIVE
  CANCELLED
}

enum LotStatus {
  ACTIVE
  CANCELLED
}

enum ProfitSplitStatus {
  ACCRUED
  TRANSFERRED
}

enum AuditEntity {
  OWNER
  PURCHASE
  SALE
  CAPITAL_MOVEMENT
  PROFIT_SPLIT
  LOT
}

model Owner {
  id                String            @id
  name              String
  type              OwnerType
  initialCapital    Decimal           @db.Decimal(14, 2)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  capitalMovements  CapitalMovement[]
  purchases         Purchase[]
  lots              Lot[]
  profitSplits      ProfitSplit[]
  users             User[]
}

model CapitalMovement {
  id            String             @id
  ownerId       String
  createdByUserId String?
  updatedByUserId String?
  type          CapitalMovementType
  amount        Decimal            @db.Decimal(14, 2)
  referenceType String
  referenceId   String
  date          DateTime
  notes         String?
  createdAt     DateTime           @default(now())
  owner         Owner              @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, date])
  @@index([referenceType, referenceId])
}

model Purchase {
  id           String         @id
  ownerId      String
  createdByUserId String?
  updatedByUserId String?
  status       PurchaseStatus @default(ACTIVE)
  cancelledAt  DateTime?
  cancelledByUserId String?
  cancelReason String?
  date         DateTime
  supplier     String
  invoiceRef   String
  subtotalNet  Decimal        @db.Decimal(14, 2)
  taxTotal     Decimal        @db.Decimal(14, 2)
  totalGross   Decimal        @db.Decimal(14, 2)
  taxRate      Decimal        @db.Decimal(8, 6)
  rawDocText   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        PurchaseLine[]
  lots         Lot[]
  owner        Owner          @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, date])
}

model PurchaseLine {
  id                  String    @id
  purchaseId          String
  lineNo              Int
  supplierSku         String
  unit                String
  descriptionRaw      String
  qty                 Decimal   @db.Decimal(14, 6)
  lineTotalNet        Decimal   @db.Decimal(14, 2)
  satProductKey       String?
  pedimento           String?
  lineTaxAllocated    Decimal   @db.Decimal(14, 2)
  lineTotalGross      Decimal   @db.Decimal(14, 2)
  unitCostNetExact    Decimal   @db.Decimal(14, 6)
  unitCostGrossExact  Decimal   @db.Decimal(14, 6)
  createdAt           DateTime  @default(now())
  purchase            Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lots                Lot[]

  @@unique([purchaseId, lineNo])
  @@index([supplierSku])
}

model Lot {
  id               String      @id
  purchaseId       String
  purchaseLineId   String
  ownerId          String
  status           LotStatus    @default(ACTIVE)
  supplierSku      String
  internalSku      String?
  description      String
  qtyBought        Decimal     @db.Decimal(14, 6)
  unitCostGross    Decimal     @db.Decimal(14, 6)
  createdAt        DateTime    @default(now())
  purchase         Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseLine     PurchaseLine @relation(fields: [purchaseLineId], references: [id], onDelete: Cascade)
  owner            Owner       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  saleLines        SaleLine[]

  @@index([ownerId])
  @@index([purchaseId])
}

model Sale {
  id                    String      @id
  createdByUserId       String?
  updatedByUserId       String?
  date                  DateTime
  channel               String
  notes                 String?
  terminalPayment       Boolean     @default(false)
  threeMonthsNoInterest Boolean     @default(false)
  commissionRate        Decimal     @db.Decimal(8, 6)
  totalGross            Decimal     @db.Decimal(14, 2)
  terminalFeeTotal      Decimal     @db.Decimal(14, 2)
  totalNetAfterFee      Decimal     @db.Decimal(14, 2)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  lines                 SaleLine[]
  profitSplits          ProfitSplit[]

  @@index([date])
}

model SaleLine {
  id              String    @id
  saleId          String
  lotId           String
  sku             String
  qty             Decimal   @db.Decimal(14, 6)
  unitPriceGross  Decimal   @db.Decimal(14, 2)
  discountGross   Decimal   @db.Decimal(14, 2)
  grossRevenue    Decimal   @db.Decimal(14, 2)
  terminalFee     Decimal   @db.Decimal(14, 2)
  netRevenue      Decimal   @db.Decimal(14, 2)
  cogsGross       Decimal   @db.Decimal(14, 2)
  profitGross     Decimal   @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lot             Lot       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  profitSplits    ProfitSplit[]

  @@index([saleId])
  @@index([lotId])
}

model ProfitSplit {
  id               String           @id
  saleId           String
  saleLineId       String?
  ownerId          String
  profitShareGross Decimal          @db.Decimal(14, 2)
  status           ProfitSplitStatus
  createdAt        DateTime         @default(now())
  sale             Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleLine         SaleLine?        @relation(fields: [saleLineId], references: [id], onDelete: SetNull)
  owner            Owner            @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([ownerId])
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  username      String   @unique
  passwordHash  String
  role          UserRole @default(OPERADOR)
  ownerId       String?
  owner         Owner?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorUserId String?
  action     String
  entity     AuditEntity
  entityId   String
  payload    Json?
  createdAt  DateTime    @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
