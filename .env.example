DATABASE_URL=postgresql://postgres:postgres@localhost:5432/motoisla_ledger?schema=public
# Producción: usar secreto DATABASE_URL_PROD en CI/CD (no guardar URL prod en archivos .env locales)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_me_with_a_random_secret
SEED_MODE=dev
SEED_BOOTSTRAP_OWNERS_JSON=[{"id":"inv_lic","name":"Lic","type":"INVESTOR","initialCapital":30000},{"id":"motoisla","name":"MotoIsla","type":"MOTOISLA","initialCapital":0}]

# Solo para SEED_MODE=dev (nunca usar estos defaults en producción)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin12345
SEED_OPERATOR_USERNAME=operador
SEED_OPERATOR_PASSWORD=operador12345
SEED_INVESTOR_USERNAME=inversionista
SEED_INVESTOR_PASSWORD=inversionista12345
SEED_INVESTOR_ID=inv_lic
SEED_INVESTOR_NAME=Lic
SEED_MOTOISLA_ID=motoisla
